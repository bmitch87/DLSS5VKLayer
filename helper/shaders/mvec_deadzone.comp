#version 450
// GPU-side NVOF post-processing: decode raw flow texels, deadzone-clamp
// sub-pixel micro-jitter to (0,0), and upscale the low-res flow grid to the
// full-resolution DLSSNR MVec resource. Never touches host memory.
//
// srcFlow : raw NVOF output bits reinterpreted as R16G16_UINT
//           (VK_FORMAT_R16G16_SFIXED5_NV -> int16/32 px, or
//            VK_FORMAT_R16G16_SFLOAT     -> half-float px)
// dstMVec : DLSSNR MVec image (VK_FORMAT_R16G16_SFLOAT, full res)
//
// Vectors are in full-resolution pixel units (current -> previous). The
// deadzone threshold is in the same units so it removes static-geometry
// noise (< 1 px) without clipping slow intentional camera pans.
//
// The flow format is a COMPILE-TIME choice (-D FLOW_FIXED5=1 or =0), not a
// specialization constant: on this driver a spec-constant branch evaluated
// false at runtime despite specialization, sending SFIXED5 bits through
// unpackHalf2x16 and writing NaN into MVec (which faults NGX). Two modules
// from one source carry no branch to mispredict, so both flow formats run
// entirely on the GPU and the host readback paths are gone.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(constant_id = 0) const uint  cGrid     = 4u;    // NVOF output grid factor
layout(constant_id = 1) const uint  cSrcW     = 480u;  // flow grid width
layout(constant_id = 2) const uint  cSrcH     = 270u;  // flow grid height
layout(constant_id = 3) const uint  cDstW     = 1920u; // MVec width
layout(constant_id = 4) const uint  cDstH     = 1080u; // MVec height
layout(constant_id = 6) const float cDeadzone = 0.5;   // px, full-res units
layout(constant_id = 7) const uint  cBilinear = 1u;    // 1 = bilinear upscale, 0 = nearest

layout(rg16ui,   binding = 0) uniform readonly  highp uimage2D srcFlow;
// rg16f, matching VK_FORMAT_R16G16_SFLOAT exactly. This declared rgba16f, and a storage
// image whose declared format does not match its view's is undefined for the WHOLE image,
// not merely for the components that do not exist -- validation says so in those words, and
// the image in question is the motion field the model reprojects with. Unlike the
// composition shader's deliberate Rgba32f-over-UNORM mismatch, which is inherited from
// upstream and measured, this one was simply wrong.
layout(rg16f,    binding = 1) uniform writeonly highp image2D  dstMVec;

#ifndef FLOW_FIXED5
#error "compile with -D FLOW_FIXED5=1 (R16G16_SFIXED5_NV) or -D FLOW_FIXED5=0 (R16G16_SFLOAT)"
#endif

vec2 DecodeFlow(uvec2 raw) {
#if FLOW_FIXED5
    int ix = int(raw.x);
    int iy = int(raw.y);
    if (ix > 32767) ix -= 65536;
    if (iy > 32767) iy -= 65536;
    return vec2(float(ix), float(iy)) * (1.0 / 32.0);
#else
    // R16G16_SFLOAT texels read through the R16G16_UINT view are raw half
    // bits; unpackHalf2x16 is their exact inverse. The uint packs low->x,
    // high->y, matching the R/G component order.
    return unpackHalf2x16(raw.x | (raw.y << 16));
#endif
}

// Deadzone applied per NVOF grid vector: low-magnitude noise clamps to exact
// zero so DLSSNR static accumulation stays perfectly locked.
vec2 SampleFlow(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(int(cSrcW), int(cSrcH)) - 1);
    vec2 v = DecodeFlow(imageLoad(srcFlow, p).xy);
    if (dot(v, v) < cDeadzone * cDeadzone) {
        return vec2(0.0);
    }
    return v;
}

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (dst.x >= int(cDstW) || dst.y >= int(cDstH)) {
        return;
    }
    vec2 v;
    if (cBilinear != 0u && cGrid > 1u) {
        vec2 f = (vec2(dst) + vec2(0.5)) / float(cGrid) - vec2(0.5);
        ivec2 p0 = ivec2(floor(f));
        vec2 w = f - vec2(p0);
        vec2 v00 = SampleFlow(p0);
        vec2 v10 = SampleFlow(p0 + ivec2(1, 0));
        vec2 v01 = SampleFlow(p0 + ivec2(0, 1));
        vec2 v11 = SampleFlow(p0 + ivec2(1, 1));
        v = mix(mix(v00, v10, w.x), mix(v01, v11, w.x), w.y);
    } else {
        v = SampleFlow(dst / int(cGrid));
    }
    imageStore(dstMVec, dst, vec4(v, 0.0, 1.0));
}